# Copier ce fichier vers .env et renseigner les valeurs du projet Supabase
# (Project Settings → API). La clé anon est publique par conception ; ne
# jamais mettre ici de clé de fournisseur de modèle de langage, qui ne vit
# que côté Edge Function (supabase/functions/generate).

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
